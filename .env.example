# PostgreSQL
POSTGRES_DB=phishchips
POSTGRES_USER=phishchips
POSTGRES_PASSWORD=changeme_strong_password

# Generate secrets before startup; example values are deliberately rejected.
# JWT secret (min 32 chars random string)
JWT_SECRET=changeme_jwt_secret_min_32_chars_random

# Secret used once to create the first local administrator (not an API credential).
ADMIN_PASSWORD=changeme_admin_password

# Published images: same tag for the API and frontend.
IMAGE_PREFIX=ghcr.io/za512/phishchipsbattle
IMAGE_TAG=latest

# Bind to 127.0.0.1 for this host only; 0.0.0.0 for direct LAN access on Unraid.
FRONTEND_BIND_IP=127.0.0.1
# Port exposed on host for the frontend (default 8080)
FRONTEND_PORT=8080

# entra for the enterprise deployment; local for a password-protected local demo.
AUTH_MODE=entra
APP_URL=http://localhost:8080
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Same-origin frontend/API deployment. Leave blank.
CORS_ORIGIN=
# Trusted private Nginx proxy; adapt when deploying on another network.
TRUST_PROXY=loopback,linklocal,uniquelocal
